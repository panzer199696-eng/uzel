# UZEL — sample settings. Copy to %USERPROFILE%\uzel-data\.env and adjust:
# УЗЕЛ — образец настроек. Скопировать в %USERPROFILE%\uzel-data\.env и
# поправить под себя:
#
#   copy .env.example %USERPROFILE%\uzel-data\.env
#
# NOT into the project folder: .env holds keys, and the project often sits in a
# folder synced to a cloud (Desktop → Google Drive). .gitignore hides the file
# from git, not from the cloud. Another location: the UZEL_ENV_FILE variable.
# НЕ в корень проекта: в .env ключи, а проект часто лежит в папке, которую
# синкает облако (Рабочий стол → Google Drive). .gitignore прячет файл от git,
# но не от облака (P11.2, находка 14). Другой путь — переменная UZEL_ENV_FILE.
# Старый .env в корне проекта ещё читается, но слабее и с предупреждением.
# All settings use the UZEL_ prefix (see core/uzel/config.py).
# Все настройки читаются с префиксом UZEL_ (см. core/uzel/config.py).
#
# ⚠️ An environment variable BEATS a line in .env. If the core keeps using a
# foreign folder, check `echo %UZEL_DATA_DIR%` first, then look for the error here.
# ⚠️ Переменная окружения СИЛЬНЕЕ строки из .env. Если ядро упрямо берёт
# чужой каталог — сначала `echo %UZEL_DATA_DIR%`, потом ищи ошибку в .env.

# --- language / язык ---------------------------------------------------------
# Interface and output language: window, tray, CLI, summaries, facts, tasks,
# Obsidian notes. auto = system language if translated (ru, en), otherwise en.
# The language picked in the window (/ui) overrides this line.
# Язык интерфейса и вывода: окно, трей, CLI, сводки, факты, задачи, заметки.
# auto — язык системы, если для него есть перевод (ru, en), иначе английский.
# Выбор языка в окне (/ui) сильнее этой строки.
UZEL_LANG=auto
# Speech recognition language: auto (whisper detects it) or a whisper code
# (ru, en, de…). In auto mode short utterances (< 4 s) borrow the language of
# confidently detected long ones in the same batch: whisper often mistakes the
# language of 1–3 s clips. If you speak one language, set it explicitly.
# Язык распознавания: auto (whisper определяет сам) или код whisper (ru, en…).
# В режиме auto короткие реплики (< 4 с) берут язык уверенно распознанных
# длинных из того же батча: на 1–3 с whisper путает языки. Говорите на одном
# языке — укажите его явно. До 27.10.2026 умолчание было ru.
UZEL_STT_LANGUAGE=auto

# --- data / где лежат данные -------------------------------------------------
# Database, raw audio, queue, search index. Keep OUTSIDE the project folder and
# outside cloud backup: voice recordings and every utterance end up here.
# Default: "<home>\uzel-data".
# База, сырое аудио, очередь, индекс поиска. Держать ВНЕ папки проекта и вне
# зоны облачного бэкапа: сюда попадают запись голоса и все реплики.
# По умолчанию — «<домашняя папка>\uzel-data».
#UZEL_DATA_DIR=D:\uzel-data

# Obsidian notes folder. Day notes go to "Projects\Uzel\Days" (ru: "Проекты\Узел\Дни"),
# tasks to "Projects\Uzel\Inbox — tasks.md" (ru: "Проекты\Узел\Входящее — задачи.md").
# The folder names follow UZEL_LANG unless set below. Root files are never touched.
# Хранилище Obsidian. Папки заметок — по языку интерфейса, если не заданы ниже.
# По умолчанию — «<домашняя папка>\Documents\Obsidian».
#UZEL_VAULT_DIR=D:\Notes
#UZEL_VAULT_DAYS_SUBDIR=Projects\Uzel\Days
#UZEL_TASKS_NOTE=Projects\Uzel\Inbox — tasks.md

# --- network / сеть ----------------------------------------------------------
# 127.0.0.1 — the core does not listen outside (NFR-005). 0.0.0.0 is needed when
# a phone talks to the core, and requires UZEL_API_TOKEN, otherwise the core
# refuses to start.
# 127.0.0.1 — наружу не слушаем (NFR-005). 0.0.0.0 нужен, когда до ядра ходит
# телефон, и требует UZEL_API_TOKEN — без него ядро не стартует вовсе (P11).
UZEL_HOST=127.0.0.1
UZEL_PORT=8770
UZEL_LOG_LEVEL=INFO
# Token for the WHOLE app (except /health): ?token=… or Authorization: Bearer …
# Токен на ВСЁ приложение (кроме /health): /ingest, /privacy, /ui/api, /omi.
#UZEL_API_TOKEN=

# --- transcription / расшифровка ---------------------------------------------
# Order = priority. "local" — faster-whisper on this PC. Adding "groq" sends
# audio to a US cloud. Not by default.
# Порядок = приоритет. "local" — faster-whisper на этом ПК.
# Добавлять "groq" сюда — значит пустить звук в облако США. По умолчанию нет.
UZEL_STT_BACKENDS=["local"]
UZEL_LOCAL_MODEL=large-v3
# Folder with a pre-downloaded model; otherwise faster-whisper downloads ~3 GB
# on the first run. Default "<home>\models-whisper".
# Папка с заранее выгруженной моделью: её наличие избавляет от похода в сеть.
#UZEL_LOCAL_MODEL_DIR=D:\models-whisper
UZEL_LOCAL_DEVICE=auto
# int8_float16 — about 2 GB of VRAM. / int8_float16 — 1963 МиБ видеопамяти.
UZEL_LOCAL_COMPUTE_TYPE=int8_float16

# --- analysis / разбор разговоров --------------------------------------------
# ollama is the only backend that runs on this PC. gateway and groq are CLOUD.
# ollama — единственный бэкенд, который считает на этом ПК.
# gateway (агент-шлюз) и groq — ОБЛАКО (см. core/uzel/llm.py).
UZEL_LLM_BACKENDS=["ollama"]
UZEL_OLLAMA_URL=http://127.0.0.1:11434
UZEL_OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
# Who wears the pendant — goes into the analysis prompt, in any language.
# Default: "user" / «пользователь» (by interface language).
# Кто носит кулон — подставляется в промпт разбора, на любом языке.
# Именительный падеж. По умолчанию — «пользователь».
#UZEL_USER_ROLE=site engineer
# Owner's frequent words, comma-separated: the analysis model fixes
# mis-recognitions towards them. Not passed to whisper (hotwords erased speech).
# Частые слова владельца через запятую: модель разбора чинит к ним ошибки
# распознавания. В whisper не подаются — там они стирали живую речь.
#UZEL_USER_VOCAB=work order, inspection report, change order
# Open task without a due date expires N days after the conversation (with a
# due date — 3 days after it). 0 — never. / Снятие застоявшихся задач, 0 — нет.
#UZEL_TASK_TTL_DAYS=10
# Semantic search model cache (255 MB). / Кэш модели смыслового поиска.
#UZEL_FASTEMBED_CACHE=D:\models-fastembed

# --- cloud (off by default) / облако (по умолчанию выключено) -----------------
# A key alone enables nothing: the backend must also be listed in *_BACKENDS.
# Ключ сам по себе ничего не включает: бэкенд ещё нужно добавить в *_BACKENDS.
#UZEL_GROQ_API_KEY=

# --- privacy / приватность ---------------------------------------------------
# No-recording windows. Format "HH:MM-HH:MM" or "HH:MM-HH:MM/mon,tue"; weekday
# names in any shipped language (mon / пн). A trailing slash without days is an
# error, not "daily".
# Окна, в которые запись не ведётся. Формат "ЧЧ:ММ-ЧЧ:ММ" либо
# "ЧЧ:ММ-ЧЧ:ММ/пн,вт,ср". Хвостовой слэш без дней — ошибка, а не «ежедневно».
#UZEL_QUIET_WINDOWS=["23:00-07:00","10:00-12:00/sat,sun"]

# --- Omi app / приложение Omi ------------------------------------------------
# Developer Mode webhooks. false → /omi answers 404.
# Приём вебхуков Developer Mode. false → раздел /omi отвечает 404.
UZEL_OMI_ENABLED=true
# A second lock on /omi on top of UZEL_API_TOKEN. / Второй замок именно на /omi.
#UZEL_OMI_TOKEN=

# --- quality filter and export / фильтр качества и выгрузка ------------------
# false — the filter flags junk but lets it through. Enable once
# `uzel quality-report` on your own material shows the thresholds are right.
# false — фильтр помечает мусор, но пропускает. Включать после того, как
# `uzel quality-report` на своём материале покажет, что пороги не врут.
UZEL_QUALITY_ENFORCE=false
# Verbatim utterances in Obsidian. Off by default: 380 chunks a day drown the index.
# Дословные реплики в Obsidian. По умолчанию нет: 380 чанков в сутки утопят индекс.
UZEL_EXPORT_TRANSCRIPT=false
